{
  "name": "tether-web-workspace",
  "version": "0.2.0-dev.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/client-ts",
    "packages/react",
    "packages/ui",
    "apps/reference-web"
  ],
  "scripts": {
    "generate:wire": "node scripts/web/generate-wire.mjs",
    "check:wire": "node scripts/web/generate-wire.mjs --check",
    "check:boundaries": "node scripts/web/check-boundaries.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint packages/client-ts packages/react packages/ui apps/reference-web tests/ui --max-warnings 0",
    "test": "node scripts/web/run-functional-command.mjs vitest",
    "build": "npm run typecheck && vite build --config apps/reference-web/vite.config.ts && node scripts/web/asset-manifest.mjs",
    "test:e2e": "node scripts/web/run-functional-command.mjs playwright",
    "check:packages": "node scripts/web/run-functional-command.mjs packages"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.105.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "15.0.4",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@11.20.0"
}
